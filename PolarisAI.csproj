<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PolarisAI</AssemblyName>
    <RootNamespace>Polaris.AI</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Runtime deployment copies this project's output directory. Keep the full
         PolarisAI.Authoring dependency closure (System.Text.Json included) beside it. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <Import Project="..\PolarisCore\build\Polaris.Runtime.props" />
  <ItemGroup>
    <Compile Remove="PolarisAI.Authoring\**\*.cs" />
    <None Remove="PolarisAI.Authoring\**\*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PolarisCore\PolarisCore.csproj" />
    <ProjectReference Include="..\PolarisRes\PolarisRes.csproj" />
    <ProjectReference Include="PolarisAI.Authoring\PolarisAI.Authoring.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Defaults\*.pai" />
  </ItemGroup>
</Project>
